<?xml version="1.0" encoding="utf-8"?>
<!-- Vaadly launcher foreground: white apartment building + green check bubble.
     Content kept inside the 66dp adaptive-icon safe zone (center of 108dp). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- building body (rounded top corners) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M42,32 h16 a4,4 0 0 1 4,4 v33 h-24 v-33 a4,4 0 0 1 4,-4 z" />

    <!-- windows -->
    <path android:fillColor="#2563EB" android:pathData="M42.5,38 h5 v5 h-5 z" />
    <path android:fillColor="#2563EB" android:pathData="M52.5,38 h5 v5 h-5 z" />
    <path android:fillColor="#2563EB" android:pathData="M42.5,47 h5 v5 h-5 z" />
    <path android:fillColor="#2563EB" android:pathData="M52.5,47 h5 v5 h-5 z" />
    <!-- door -->
    <path android:fillColor="#2563EB" android:pathData="M46.5,57 h7 v12 h-7 z" />

    <!-- check bubble -->
    <path
        android:fillColor="#10B981"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:pathData="M64,52 a11,11 0 1 1 -0.01,0 z" />
    <path
        android:pathData="M59.2,63.2 l3.4,3.4 6.6,-7"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
