# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.vercel

# One-off maintenance scripts often contain access tokens — never commit them
scripts/*.cjs
.env
.env.*

# Local tooling / generated
.claude/
supabase/.temp/

# Signing keystores must never be committed (the 2026-10 incident: committed keystore + plaintext password = anyone could ship a trojan update)
*.keystore
*.jks
*.p12
